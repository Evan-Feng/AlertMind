# ===== Application =====
APP_ENV=development                 # development | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== PostgreSQL =====
POSTGRES_USER=alertmind
POSTGRES_PASSWORD=alertmind
POSTGRES_DB=alertmind
DATABASE_URL=postgresql+asyncpg://alertmind:alertmind@localhost:15432/alertmind

# ===== Redis =====
REDIS_URL=redis://localhost:16379/0

# ===== LLM Provider (阶段 4 使用) =====
LLM_PROVIDER=openai                 # openai | claude | qwen | ollama
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=                       # 留空用官方，qwen/ollama 用自定义

# ===== Aggregation (阶段 3 使用) =====
AGGREGATION_SIMILARITY_THRESHOLD=0.85
AGGREGATION_WINDOW_HOURS=24
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DROP_LABELS=pod,container_id,instance_id,replica_id,uid,request_id,trace_id

# ===== Notifiers (阶段 6 使用) =====
WECOM_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
